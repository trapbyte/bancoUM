generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model auditoria_movimiento {
  id_auditoria     BigInt    @id @default(autoincrement())
  id_movimiento    BigInt?
  usuario_bd       String?
  fecha            DateTime? @default(now()) @db.Timestamp(6)
  accion           String?
  datos_anteriores Json?
  datos_nuevos     Json?
}

model barrio {
  id_barrio      Int              @id @default(autoincrement())
  id_comuna      Int
  nombre         String           @db.VarChar(150)
  comuna         comuna           @relation(fields: [id_comuna], references: [id_comuna], onDelete: NoAction, onUpdate: NoAction)
  cliente        cliente[]
  punto_atencion punto_atencion[]

  @@unique([id_comuna, nombre])
  @@index([id_comuna], map: "idx_barrio_comuna")
}

model cliente {
  id_cliente       Int              @id @default(autoincrement())
  tipo_documento   String           @db.VarChar(5)
  numero_documento String           @unique @db.VarChar(20)
  nombres          String           @db.VarChar(100)
  apellidos        String           @db.VarChar(100)
  fecha_nacimiento DateTime         @db.Date
  email            String?          @db.VarChar(150)
  telefono         String?          @db.VarChar(20)
  id_barrio        Int?
  fecha_registro   DateTime?        @default(now()) @db.Timestamp(6)
  activo           Boolean?         @default(true)
  password_hash    String?          @db.VarChar(255)
  barrio           barrio?          @relation(fields: [id_barrio], references: [id_barrio], onDelete: NoAction, onUpdate: NoAction)
  cliente_cuenta   cliente_cuenta[]
  cuenta           cuenta[]

  @@index([id_barrio], map: "idx_cliente_barrio")
}

model cliente_cuenta {
  id_cliente        Int
  id_cuenta         Int
  titular_principal Boolean? @default(false)
  cliente           cliente  @relation(fields: [id_cliente], references: [id_cliente], onDelete: NoAction, onUpdate: NoAction)
  cuenta            cuenta   @relation(fields: [id_cuenta], references: [id_cuenta], onDelete: NoAction, onUpdate: NoAction)

  @@id([id_cliente, id_cuenta])
}

model comuna {
  id_comuna    Int       @id @default(autoincrement())
  id_municipio Int
  nombre       String    @db.VarChar(100)
  barrio       barrio[]
  municipio    municipio @relation(fields: [id_municipio], references: [id_municipio], onDelete: NoAction, onUpdate: NoAction)

  @@unique([id_municipio, nombre])
  @@index([id_municipio], map: "idx_comuna_municipio")
}

model cuenta {
  id_cuenta                                       Int              @id @default(autoincrement())
  numero_cuenta                                   String           @unique @db.VarChar(30)
  id_tipo_cuenta                                  Int
  saldo                                           Decimal          @default(0) @db.Decimal(18, 2)
  limite_credito                                  Decimal?         @db.Decimal(18, 2)
  fecha_apertura                                  DateTime         @db.Date
  estado                                          String?          @default("ACTIVA") @db.VarChar(20)
  id_cliente                                      Int?
  cliente_cuenta                                  cliente_cuenta[]
  tipo_cuenta                                     tipo_cuenta      @relation(fields: [id_tipo_cuenta], references: [id_tipo_cuenta], onDelete: NoAction, onUpdate: NoAction)
  cliente                                         cliente?         @relation(fields: [id_cliente], references: [id_cliente], onDelete: NoAction, onUpdate: NoAction, map: "fk_cuenta_cliente")
  movimiento_movimiento_id_cuenta_destinoTocuenta movimiento[]     @relation("movimiento_id_cuenta_destinoTocuenta")
  movimiento_movimiento_id_cuenta_origenTocuenta  movimiento[]     @relation("movimiento_id_cuenta_origenTocuenta")

  @@index([id_cliente], map: "idx_cuenta_cliente")
  @@index([id_tipo_cuenta], map: "idx_cuenta_tipo")
}

model departamento {
  id_departamento Int         @id @default(autoincrement())
  nombre          String      @unique @db.VarChar(100)
  codigo_dane     String      @unique(map: "uq_departamento_dane") @db.Char(2)
  municipio       municipio[]
}

model empleado {
  id_empleado        Int              @id @default(autoincrement())
  tipo_documento     String           @db.VarChar(5)
  numero_documento   String           @unique @db.VarChar(20)
  nombres            String           @db.VarChar(100)
  apellidos          String           @db.VarChar(100)
  cargo              String           @db.VarChar(100)
  fecha_contratacion DateTime         @db.Date
  activo             Boolean?         @default(true)
  email              String?          @db.VarChar(150)
  password_hash      String?          @db.VarChar(255)
  empleado_punto     empleado_punto[]
  movimiento         movimiento[]
}

model empleado_punto {
  id_empleado    Int
  id_punto       Int
  fecha_inicio   DateTime       @db.Date
  fecha_fin      DateTime?      @db.Date
  empleado       empleado       @relation(fields: [id_empleado], references: [id_empleado], onDelete: NoAction, onUpdate: NoAction)
  punto_atencion punto_atencion @relation(fields: [id_punto], references: [id_punto], onDelete: NoAction, onUpdate: NoAction)

  @@id([id_empleado, id_punto, fecha_inicio])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model movimiento {
  id_movimiento                               BigInt               @id @default(autoincrement())
  fecha                                       DateTime             @default(now()) @db.Timestamp(6)
  tipo                                        tipo_movimiento_enum
  id_cuenta_origen                            Int?
  id_cuenta_destino                           Int?
  monto                                       Decimal              @db.Decimal(18, 2)
  id_punto                                    Int?
  id_empleado                                 Int?
  descripcion                                 String?
  referencia_externa                          String?              @db.VarChar(100)
  estado                                      String?              @default("CONFIRMADO") @db.VarChar(20)
  cuenta_movimiento_id_cuenta_destinoTocuenta cuenta?              @relation("movimiento_id_cuenta_destinoTocuenta", fields: [id_cuenta_destino], references: [id_cuenta], onDelete: NoAction, onUpdate: NoAction)
  cuenta_movimiento_id_cuenta_origenTocuenta  cuenta?              @relation("movimiento_id_cuenta_origenTocuenta", fields: [id_cuenta_origen], references: [id_cuenta], onDelete: NoAction, onUpdate: NoAction)
  empleado                                    empleado?            @relation(fields: [id_empleado], references: [id_empleado], onDelete: NoAction, onUpdate: NoAction)
  punto_atencion                              punto_atencion?      @relation(fields: [id_punto], references: [id_punto], onDelete: NoAction, onUpdate: NoAction)

  @@index([id_cuenta_destino], map: "idx_mov_destino")
  @@index([fecha], map: "idx_mov_fecha")
  @@index([id_cuenta_origen], map: "idx_mov_origen")
  @@index([id_punto], map: "idx_mov_punto")
  @@index([id_cuenta_destino], map: "idx_movimiento_destino")
  @@index([estado], map: "idx_movimiento_estado")
  @@index([fecha], map: "idx_movimiento_fecha")
  @@index([id_cuenta_origen], map: "idx_movimiento_origen")
}

model municipio {
  id_municipio    Int          @id @default(autoincrement())
  id_departamento Int
  nombre          String       @db.VarChar(100)
  codigo_dane     String       @unique(map: "uq_municipio_dane") @db.Char(5)
  comuna          comuna[]
  departamento    departamento @relation(fields: [id_departamento], references: [id_departamento], onDelete: NoAction, onUpdate: NoAction)

  @@unique([id_departamento, nombre])
  @@index([id_departamento], map: "idx_municipio_departamento")
}

model punto_atencion {
  id_punto       Int              @id @default(autoincrement())
  nombre         String           @db.VarChar(150)
  tipo           tipo_punto_enum
  id_barrio      Int
  direccion      String           @db.VarChar(200)
  telefono       String?          @db.VarChar(20)
  activo         Boolean?         @default(true)
  fecha_apertura DateTime         @db.Date
  fecha_cierre   DateTime?        @db.Date
  empleado_punto empleado_punto[]
  movimiento     movimiento[]
  barrio         barrio           @relation(fields: [id_barrio], references: [id_barrio], onDelete: NoAction, onUpdate: NoAction)

  @@index([id_barrio], map: "idx_punto_barrio")
  @@index([tipo], map: "idx_punto_tipo")
}

model tipo_cuenta {
  id_tipo_cuenta    Int              @id @default(autoincrement())
  tipo              tipo_cuenta_enum @unique
  tasa_interes      Decimal?         @db.Decimal(5, 2)
  cuota_manejo      Decimal?         @db.Decimal(12, 2)
  permite_sobregiro Boolean?         @default(false)
  cuenta            cuenta[]
}

enum tipo_cuenta_enum {
  AHORROS
  CORRIENTE
  TARJETA_CREDITO
}

enum tipo_movimiento_enum {
  DEPOSITO
  RETIRO
  TRANSFERENCIA
  PAGO
  COMPRA_TARJETA
}

enum tipo_punto_enum {
  SUCURSAL
  CAJERO_AUTOMATICO
  CORRESPONSAL
}
